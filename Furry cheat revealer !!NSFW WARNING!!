-- Функция умного скачивания (Парсит HTML ibb.co и достает прямую ссылку на PNG)
local function download_file(url, filename, callback)
    http.get(url, function(success, response)
        if success and response.status == 200 then
            local body = response.body
            -- Ищем прямую ссылку через OpenGraph тег
            local direct_url = string.match(body, 'meta property="og:image" content="([^"]+)"')
            if direct_url then
                -- Качаем саму картинку
                http.get(direct_url, function(s2, r2)
                    if s2 and r2.status == 200 then
                        writefile("kev_rev/" .. filename, r2.body)
                    end
                    callback()
                end)
            else
                -- Если ссылка уже была прямой
                writefile("kev_rev/" .. filename, body)
                callback()
            end
        else
            callback() -- Если ошибка сети, продолжаем чтобы не зависнуть
        end
    end)
end

