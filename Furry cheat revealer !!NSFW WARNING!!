                        row_y = row_y + row_h + math.floor(6 * scale)
                    end
                end
            end
        end

        if view_transition > 0.01 then
            zoom_anim = fast_lerp(zoom_anim, is_zoomed and 1 or 0, 12, dt)
            local det_alpha = math.floor(alpha * view_transition)
            local d_off = math.floor(80 * (1 - view_transition))
            local cx = menu_x + w/2 + d_off
            local info = cheat_info[selected_cheat] or cheat_info["wh"]

            if zoom_anim > 0.01 then draw_main_bg(menu_x, menu_y, w, h, 10 * scale, 0, 0, 0, math.floor(200 * zoom_anim * view_transition)) end
            
            local btn_w, btn_h = math.floor(150 * scale), math.floor(35 * scale)
            local btn_y = menu_y + h - math.floor(55 * scale)
            
            local back_x = cx - btn_w - math.floor(10 * scale)
            local re_x = cx + math.floor(10 * scale)
            
            local hov_bk = (mx >= back_x and mx <= back_x+btn_w and my >= btn_y and my <= btn_y+btn_h) and not is_zoomed
            local hov_re = (mx >= re_x and mx <= re_x+btn_w and my >= btn_y and my <= btn_y+btn_h) and not is_zoomed
            
            hover_states["bk"] = fast_lerp(hover_states["bk"] or 0, hov_bk and 1 or 0, 15, dt)
            hover_states["re"] = fast_lerp(hover_states["re"] or 0, hov_re and 1 or 0, 15, dt)

            local txt_alpha = math.floor(det_alpha * (1 - zoom_anim))

            local br = math.floor(lerp(40, tr, hover_states["bk"]))
            local bg = math.floor(lerp(40, tg, hover_states["bk"]))
            local bb = math.floor(lerp(45, tb, hover_states["bk"]))
            draw_fast_rect(back_x, btn_y, btn_w, btn_h, br, bg, bb, txt_alpha)
            renderer.text(back_x + btn_w/2, btn_y + btn_h/2, 255, 255, 255, txt_alpha, "cb", 0, "GO BACK")
            if hov_bk and clicked and view_transition > 0.9 then view_state = 0 end

            local rr = math.floor(lerp(40, 255, hover_states["re"]))
            local rg = math.floor(lerp(40, 100, hover_states["re"]))
            local rb = math.floor(lerp(45, 100, hover_states["re"]))
            draw_fast_rect(re_x, btn_y, btn_w, btn_h, rr, rg, rb, txt_alpha)
            renderer.text(re_x + btn_w/2, btn_y + btn_h/2, 255, 255, 255, txt_alpha, "cb", 0, "RE-ANALYZE")
            if hov_re and clicked and view_transition > 0.9 then 
                reset_player(selected_idx); client.color_log(255, 150, 150, "[Kev's Revealer] Rescanning " .. tostring(selected_player))
                view_state = 0
            end

            local ty = menu_y + math.floor(250 * scale)
            renderer.text(cx, ty, info.color[1], info.color[2], info.color[3], txt_alpha, "cb+", 0, string.upper(info.name))
            renderer.text(cx, ty + math.floor(15*scale), 150, 150, 150, txt_alpha, "c", 0, "Detected on: " .. tostring(selected_player))
            renderer.rectangle(cx - math.floor(150 * scale), menu_y + math.floor(280 * scale), math.floor(300 * scale), 1, tr, tg, tb, math.floor(txt_alpha * 0.5))

            local function draw_badge(bx, by, bw, bh, t, v, clr)
                draw_fast_rect(bx, by, bw, bh, 35, 35, 40, txt_alpha)
                renderer.text(bx + 10, by + 10, 130, 130, 130, txt_alpha, "", 0, t)
                renderer.text(bx + 10, by + 25, clr[1], clr[2], clr[3], txt_alpha, "b", 0, v)
            end
            
            local cw, ch = math.floor(160 * scale), math.floor(50 * scale)
            local cy = menu_y + math.floor(300 * scale)
            draw_badge(cx - cw - 10, cy, cw, ch, "CREATOR", info.creator, {255, 255, 255})
            draw_badge(cx + 10, cy, cw, ch, "CRACKED", info.cracked, {255, 100, 100})
            draw_badge(cx - cw - 10, cy + ch + 10, cw, ch, "PROS", info.pros, {100, 255, 100})
            draw_badge(cx + 10, cy + ch + 10, cw, ch, "CONS", info.cons, {255, 150, 50})
            renderer.text(cx, cy + ch*2 + math.floor(35*scale), 180, 180, 180, txt_alpha, "c", 0, info.desc)

            local def_s = math.floor(140 * scale)
            local z_s = math.floor(400 * scale)
            local cur_s = math.floor(lerp(def_s, z_s, zoom_anim))
            local cur_y = math.floor(lerp(menu_y + math.floor(90 * scale), menu_y + h/2 - cur_s/2, zoom_anim))
            local cur_x = cx - cur_s/2

            if clicked and view_transition > 0.9 then
                if mx >= cur_x and mx <= cur_x+cur_s and my >= cur_y and my <= cur_y+cur_s then is_zoomed = not is_zoomed else is_zoomed = false end
            end
            draw_icon(selected_cheat, cur_x, cur_y, cur_s, cur_s, det_alpha)
        end
    end)
end

-- ==========================================
-- ЛОГИКА АВТОЗАГРУЗЧИКА ФАЙЛОВ
-- ==========================================
if #missing_files > 0 then
    -- Показываем UI меню для загрузки
    local ui_lbl1 = ui.new_label(tab, container, "====== MISSING ICONS ======")
    local ui_lbl2 = ui.new_label(tab, container, "При использовании данной Lua, будут автоматически скачаны иконки.")
    local ui_lbl3 = ui.new_label(tab, container, "Do you want to redownload files that you don't have?")
    local btn_yes, btn_no

    local function hide_downloader_ui()
        ui.set_visible(ui_lbl1, false)
        ui.set_visible(ui_lbl2, false)
        ui.set_visible(ui_lbl3, false)
        ui.set_visible(btn_yes, false)
        ui.set_visible(btn_no, false)
    end

    btn_yes = ui.new_button(tab, container, "Yes, download files", function()
        -- Отключаем кнопки чтобы не нажимали дважды
        ui.set_visible(btn_yes, false)
        ui.set_visible(btn_no, false)
        
        local downloaded_count = 0
        ui.set(ui_lbl3, string.format("Downloading... %d / %d", downloaded_count, #missing_files))

        -- Цикл скачивания
        for _, file in ipairs(missing_files) do
            download_file(file.url, file.name, function()
                downloaded_count = downloaded_count + 1
                ui.set(ui_lbl3, string.format("Downloading... %d / %d", downloaded_count, #missing_files))
                
                -- Если всё скачали
                if downloaded_count == #missing_files then
                    hide_downloader_ui()
                    start_main_script()
                end
            end)
        end
    end)

    btn_no = ui.new_button(tab, container, "No, run without icons", function()
        hide_downloader_ui()
        start_main_script()
    end)
else
    -- Если все картинки на месте, запускаем скрипт без вопросов
     start_main_script()
end
