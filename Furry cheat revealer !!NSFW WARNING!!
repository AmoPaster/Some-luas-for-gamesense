local function download_file(url, filename, callback)
    http.get(url, function(success, response)
        if success and response.status == 200 then
            local direct_url = string.match(response.body, 'meta property="og:image" content="([^"]+)"')
            if direct_url then
                http.get(direct_url, function(s2, r2)
                    if s2 and r2.status == 200 then writefile("kev_rev/" .. filename, r2.body) end
                    callback()
                end)
            else
                writefile("kev_rev/" .. filename, response.body)
                callback()
            end
        else
            callback()
        end
    end)
end

